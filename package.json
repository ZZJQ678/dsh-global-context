{
  "name": "dsh-global-context",
  "version": "1.1.0",
  "description": "全局上下文：把一段自定义提示词注入到每个会话系统提示词的最顶部，并在对话视图新增「全局上下文配置」标签页（文本框可直接编辑、保存、清空）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "global-context",
    "system-prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZZJQ678/dsh-global-context.git"
  },
  "homepage": "https://github.com/ZZJQ678/dsh-global-context#readme",
  "bugs": {
    "url": "https://github.com/ZZJQ678/dsh-global-context/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "license": "MIT"
}
